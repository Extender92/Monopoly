{
  "schemaVersion": 1,
  "policy": {
    "uncertainContent": "review",
    "publicationBlocks": [
      "replace",
      "remove",
      "review"
    ]
  },
  "auditMaterial": [
    "docs/clean-publication-audit.md",
    "eng/publication/**",
    "publication-audit*.json",
    "publication-audit*.txt"
  ],
  "textExtensions": [
    ".cs",
    ".csproj",
    ".gitignore",
    ".json",
    ".md",
    ".patterns",
    ".ps1",
    ".props",
    ".sln",
    ".targets",
    ".txt",
    ".xml",
    ".yaml",
    ".yml"
  ],
  "textFileNames": [
    ".gitignore",
    "LICENSE",
    "NOTICE"
  ],
  "artifactBinaryRules": [
    {
      "extensions": [
        "",
        ".dll",
        ".exe",
        ".pdb"
      ],
      "classification": "allow",
      "rationale": "Expected unpacked .NET Release output; filenames and embedded UTF-8/ASCII and UTF-16 text are still scanned."
    }
  ],
  "requiredPublicationFiles": [
    {
      "path": "LICENSE",
      "ownerIssues": [57]
    },
    {
      "path": "NOTICE",
      "ownerIssues": [57]
    },
    {
      "path": "CONTRIBUTING.md",
      "ownerIssues": [57]
    }
  ],
  "forbiddenPaths": [
    {
      "patterns": [
        ".git",
        ".git/**",
        "**/.git",
        "**/.git/**",
        ".vs",
        ".vs/**",
        "**/.vs",
        "**/.vs/**",
        "bin",
        "bin/**",
        "**/bin",
        "**/bin/**",
        "obj",
        "obj/**",
        "**/obj",
        "**/obj/**",
        "TestResults",
        "TestResults/**",
        "**/TestResults",
        "**/TestResults/**",
        "test_results",
        "test_results/**",
        "**/test_results",
        "**/test_results/**",
        "artifacts",
        "artifacts/**",
        "**/artifacts",
        "**/artifacts/**",
        "game_data.json",
        "saves",
        "saves/**",
        "**/saves",
        "**/saves/**",
        "publication-audit*.json",
        "publication-audit*.txt",
        "**/*.tmp",
        "**/*.temp",
        "**/*.log"
      ],
      "classification": "remove",
      "ownerIssues": [58]
    }
  ],
  "fileRules": [
    {
      "id": "root-project-files",
      "patterns": [
        "*"
      ],
      "ownership": "project-owned",
      "classification": "allow",
      "ownerIssues": [55]
    },
    {
      "id": "generic-source-files",
      "patterns": [
        "**/*.cs",
        "**/*.csproj",
        "**/*.props",
        "**/*.targets",
        "**/*.sln"
      ],
      "ownership": "project-owned",
      "classification": "allow",
      "ownerIssues": [55]
    },
    {
      "id": "generic-documentation-and-configuration",
      "patterns": [
        "**/*.md",
        "**/*.json",
        "**/*.txt",
        "**/*.patterns",
        "**/*.yml",
        "**/*.yaml",
        ".github/**"
      ],
      "ownership": "project-owned",
      "classification": "allow",
      "ownerIssues": [55]
    },
    {
      "id": "raw-publication-audit",
      "patterns": [
        "docs/clean-publication-audit.md",
        "eng/publication/**"
      ],
      "ownership": "project-owned",
      "classification": "remove",
      "ownerIssues": [58]
    },
    {
      "id": "regional-board-and-card-data",
      "patterns": [
        "Monopoly.Core/Data/Data.cs",
        "Monopoly.Core/Models/FortuneCard/UKChanceCard.cs",
        "Monopoly.Core/Models/FortuneCard/UKCommunityChestCard.cs",
        "Monopoly.Core/Models/FortuneCard/USChanceCard.cs",
        "Monopoly.Core/Models/FortuneCard/USCommunityChestCard.cs"
      ],
      "ownership": "project-owned-with-third-party-presentation",
      "classification": "replace",
      "ownerIssues": [4, 37]
    },
    {
      "id": "regional-rule-documents",
      "patterns": [
        "docs/game-rules.md",
        "docs/rules/uk-classic.md",
        "docs/rules/us-classic.md",
        "docs/rules/custom.md"
      ],
      "ownership": "project-owned-with-third-party-references",
      "classification": "replace",
      "ownerIssues": [4, 37, 56]
    },
    {
      "id": "product-shaped-tests",
      "patterns": [
        "Monopoly.Tests/CoreTests/CardTests.cs",
        "Monopoly.Tests/CoreTests/DataTests.cs",
        "Monopoly.Tests/CoreTests/FortuneCardHandlerTests.cs",
        "Monopoly.Tests/CoreTests/GameBoardTests.cs",
        "Monopoly.Tests/CoreTests/GameFlowIntegrationTests.cs"
      ],
      "ownership": "project-owned-with-third-party-fixtures",
      "classification": "replace",
      "ownerIssues": [4, 37]
    },
    {
      "id": "legacy-save-contract",
      "patterns": [
        "Monopoly.Core/SaveAndLoad/**"
      ],
      "ownership": "project-owned",
      "classification": "replace",
      "ownerIssues": [52]
    },
    {
      "id": "derived-spelling-configuration",
      "patterns": [
        ".github/actions/spelling/**"
      ],
      "ownership": "third-party-derived-configuration",
      "classification": "review",
      "ownerIssues": [57]
    }
  ],
  "contentRules": [
    {
      "id": "legacy-product-and-repository-identity",
      "matchType": "regex",
      "patterns": [
        "(?i)\\bMonopoly\\b",
        "(?i)CCMR-Monopoly",
        "(?i)CodeCraftersMR/CCMR-Monopoly"
      ],
      "targets": [
        "path",
        "content"
      ],
      "classification": "replace",
      "ownerIssues": [56]
    },
    {
      "id": "publisher-and-edition-evidence",
      "matchType": "literal",
      "patterns": [
        "Hasbro",
        "C1009",
        "0622C1009780",
        "C10090000 17 I MN",
        "instructions.hasbro.com",
        "www.hasbro.com"
      ],
      "targets": [
        "path",
        "content"
      ],
      "caseSensitive": false,
      "classification": "remove",
      "ownerIssues": [4]
    },
    {
      "id": "regional-profile-symbols",
      "matchType": "regex",
      "patterns": [
        "(?i)\\bUK Classic\\b",
        "(?i)\\bUS Classic\\b",
        "\\bGameLanguage\\b",
        "\\bLanguage\\.(UK|US)\\b",
        "\\b(UK|US)(Chance|CommunityChest)Card(Type)?\\b"
      ],
      "targets": [
        "path",
        "content"
      ],
      "classification": "replace",
      "ownerIssues": [4, 37, 52]
    },
    {
      "id": "official-board-and-square-names",
      "matchType": "literal",
      "patterns": [
        "Atlantic Avenue",
        "Baltic Avenue",
        "Boardwalk",
        "Bond Street",
        "Bow Street",
        "Connecticut Avenue",
        "Coventry Street",
        "Euston Road",
        "Fleet Street",
        "Illinois Avenue",
        "Indiana Avenue",
        "Kentucky Avenue",
        "Leicester Square",
        "Marlborough Street",
        "Marvin Gardens",
        "Mayfair",
        "Mediterranean Avenue",
        "New York Avenue",
        "North Carolina Avenue",
        "Northumberland Avenue",
        "Old Kent Road",
        "Oriental Avenue",
        "Oxford Street",
        "Pacific Avenue",
        "Pall Mall",
        "Park Lane",
        "Park Place",
        "Pennsylvania Avenue",
        "Pentonville Road",
        "Piccadilly",
        "Regent Street",
        "St. Charles Place",
        "St. James Place",
        "States Avenue",
        "Tennessee Avenue",
        "The Angel Islington",
        "The Strand",
        "Trafalgar Square",
        "Ventnor Avenue",
        "Vermont Avenue",
        "Vine Street",
        "Virginia Avenue",
        "Whitechapel Road",
        "Whitehall",
        "B&O Railroad",
        "Electric Company",
        "Fenchurch Street Station",
        "Income Tax",
        "Kings Cross Station",
        "Luxury Tax",
        "Marylebone Station",
        "Pennsylvania Railroad",
        "Reading Railroad",
        "Short Line",
        "Water Works"
      ],
      "targets": [
        "path",
        "content"
      ],
      "caseSensitive": false,
      "classification": "replace",
      "ownerIssues": [4]
    },
    {
      "id": "verbatim-card-text",
      "matchType": "literal",
      "patterns": [
        "Advance to Boardwalk",
        "Advance to Go (Collect $200)",
        "Advance to Go (Collect £200)",
        "Advance to Go (Collect 200)",
        "Advance to Illinois Avenue. If you pass Go, collect $200",
        "Advance to Mayfair",
        "Advance to Pall Mall. If you pass Go, collect £200",
        "Advance to St. Charles Place. If you pass Go, collect $200",
        "Advance to the nearest Railroad. If unowned, you may buy it from the Bank. If owned, pay owner twice the rental to which they are otherwise entitled",
        "Advance to the nearest Station. If unowned, you may buy it from the Bank. If owned, pay wonder twice the rental to which they are otherwise entitled",
        "Advance to Trafalgar Square. If you pass Go, collect £200",
        "Advance token to nearest Utility. If unowned, you may buy it from the Bank. If owned, throw dice and pay owner a total ten times amount thrown.",
        "Advance token to nearest Utility. If unowned, you may buy it from the Bank. If owned, throw dice and pay owner a total ten times the amount thrown",
        "Bank error in your favor. Collect $200",
        "Bank error in your favour. Collect £200",
