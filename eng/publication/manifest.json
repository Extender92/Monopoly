        "Bank pays you dividend of £50",
        "Doctor’s fee. Pay $50",
        "Doctor’s fee. Pay £50",
        "From sale of stock you get $50",
        "From sale of stock you get £50",
        "Get Out of Jail Free",
        "Go Back 3 Spaces",
        "Go to Jail. Go directly to Jail, do not pass Go, do not collect $200",
        "Go to Jail. Go directly to jail, do not pass Go, do not collect £200",
        "Holiday fund matures. Receive $100",
        "Holiday fund matures. Receive £100",
        "Income tax refund. Collect $20",
        "Income tax refund. Collect £20",
        "It is your birthday. Collect $10 from every player",
        "It is your birthday. Collect £10 from every player",
        "Life insurance matures. Collect $100",
        "Life insurance matures. Collect £100",
        "Make general repairs on all your property. For each house pay £25. For each hotel pay £100",
        "Make general repairs on all your property. For each house, pay $25. For each hotel, pay $100",
        "Pay hospital fees of $100",
        "Pay hospital fees of £100",
        "Pay school fees of $50",
        "Pay school fees of £50",
        "Receive $25 consultancy fee",
        "Receive £25 consultancy fee",
        "Speeding fine $15",
        "Speeding fine £15",
        "Take a trip to Kings Cross Station. If you pass Go, collect £200",
        "Take a trip to Reading Railroad. If you pass Go, collect $200",
        "You are assessed for street repair. $40 per house. $115 per hotel",
        "You are assessed for street repairs. £40 per house. £115 per hotel",
        "You have been elected Chairman of the Board. Pay each player $50",
        "You have been elected Chairman of the Board. Pay each player £50",
        "You have won second prize in a beauty contest. Collect $10",
        "You have won second prize in a beauty contest. Collect £10",
        "You inherit $100",
        "You inherit £100",
        "Your building loan matures. Collect $150",
        "Your building loan matures. Collect £150"
      ],
      "targets": [
        "content"
      ],
      "caseSensitive": false,
      "classification": "replace",
      "ownerIssues": [4]
    },
    {
      "id": "product-shaped-decks-and-detention",
      "matchType": "regex",
      "patterns": [
        "(?i)\\bChance(Card|Deck|Square)?\\b",
        "(?i)\\bCommunity\\s*Chest(Card|Deck|Square)?\\b",
        "(?i)\\bFree Parking\\b",
        "(?i)\\bGet Out of Jail Free\\b",
        "(?i)\\bGo To Jail\\b",
        "(?i)\\bJail\\b"
      ],
      "targets": [
        "path",
        "content"
      ],
      "classification": "replace",
      "ownerIssues": [4, 37, 52]
    },
    {
      "id": "legacy-save-symbols",
      "matchType": "literal",
      "patterns": [
        "ChanceDeck",
        "CommunityChestDeck",
        "JailState",
        "GameStateV1"
      ],
      "targets": [
        "path",
        "content"
      ],
      "caseSensitive": true,
      "classification": "replace",
      "ownerIssues": [52]
    },
    {
      "id": "complete-official-data-shape",
      "matchType": "regex",
      "patterns": [
        "(?i)\\b40[- ]?(space|square) board\\b",
        "(?i)\\b32 houses?\\b.{0,80}\\b12 hotels?\\b",
        "(?i)\\b16 chance\\b.{0,80}\\b16 community chest\\b",
        "(?i)\\b28 title deeds?\\b"
      ],
      "targets": [
        "content"
      ],
      "classification": "review",
      "ownerIssues": [4, 37]
    }
  ],
  "allowRules": [
    {
      "id": "independently-written-property-trading-code",
      "patterns": [
        "**/*.cs",
        "**/*.csproj"
      ],
      "rationale": "Project-owned implementation may express generic mechanics when no deny rule matches."
    },
    {
      "id": "generic-mechanics-terminology",
      "patterns": [
        "docs/**",
        "**/*.cs"
      ],
      "terms": [
        "dice",
        "movement",
        "ownership",
        "rent",
        "auction",
        "detention",
        "mortgage",
        "building",
        "trading",
        "bankruptcy"
      ],
      "rationale": "Generic property-trading mechanics written in original language are allowed; this never overrides a deny finding."
    }
  ],
