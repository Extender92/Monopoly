{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-save-v2.schema.json",
  "title": "Property-trading match save format version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "profile", "match"],
  "properties": {
    "formatVersion": { "const": 2 },
    "profile": { "$ref": "#/$defs/profile" },
    "match": { "$ref": "#/$defs/match" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "playerId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "fingerprint"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "value"],
      "properties": {
        "resourceId": { "$ref": "#/$defs/identifier" },
        "value": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerId", "name", "spaceId", "resources"],
      "properties": {
        "playerId": { "$ref": "#/$defs/playerId" },
        "name": { "type": "string", "minLength": 1 },
        "spaceId": { "$ref": "#/$defs/identifier" },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource" }
        }
      }
    },
    "diceRoll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "results"],
      "properties": {
        "purpose": { "const": "turn-dice" },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
        }
      }
    },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deckId", "cardIds"],
      "properties": {
        "deckId": { "$ref": "#/$defs/identifier" },
        "cardIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "ownershipEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spaceId", "ownerPlayerId"],
      "properties": {
        "spaceId": { "$ref": "#/$defs/identifier" },
        "ownerPlayerId": {
          "oneOf": [
            { "$ref": "#/$defs/playerId" },
            { "type": "null" }
          ]
        }
      }
    },
    "statusEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerId", "statusId", "value"],
      "properties": {
        "playerId": { "$ref": "#/$defs/playerId" },
        "statusId": { "$ref": "#/$defs/identifier" },
        "value": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "moduleState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownership", "statuses"],
      "properties": {
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "entries"],
          "properties": {
            "version": { "const": 1 },
            "entries": {
              "type": "array",
              "maxItems": 512,
              "items": { "$ref": "#/$defs/ownershipEntry" }
            }
          }
        },
        "statuses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "entries"],
          "properties": {
            "version": { "const": 1 },
            "entries": {
              "type": "array",
              "maxItems": 0,
              "items": { "$ref": "#/$defs/statusEntry" }
            }
          }
        }
      }
    },
    "pendingDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "kind",
        "playerId",
        "allowedResponses",
        "spaceId",
        "price"
      ],
      "properties": {
        "decisionId": { "$ref": "#/$defs/guid" },
        "kind": { "const": "purchase" },
        "playerId": { "$ref": "#/$defs/playerId" },
        "allowedResponses": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "const": "accept" },
            { "const": "decline" }
          ],
          "items": false
        },
        "spaceId": { "$ref": "#/$defs/identifier" },
        "price": { "$ref": "#/$defs/resource" }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerId", "spaceId", "nextCapabilityIndex"],
      "properties": {
        "playerId": { "$ref": "#/$defs/playerId" },
        "spaceId": { "$ref": "#/$defs/identifier" },
        "nextCapabilityIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "players",
        "currentPlayerId",
        "roundAnchorPlayerId",
        "roundNumber",
        "phase",
        "lastDiceRoll",
        "winnerPlayerId",
        "decks",
        "moduleState",
        "pendingDecision",
        "continuation",
        "consumedDecisionIds",
        "lastConsumedDecisionId"
      ],
      "properties": {
        "players": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/player" }
        },
        "currentPlayerId": { "$ref": "#/$defs/playerId" },
        "roundAnchorPlayerId": { "$ref": "#/$defs/playerId" },
        "roundNumber": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "phase": {
          "enum": ["ready-for-turn", "awaiting-decision", "game-over"]
        },
        "lastDiceRoll": {
          "oneOf": [
            { "$ref": "#/$defs/diceRoll" },
            { "type": "null" }
          ]
        },
        "winnerPlayerId": {
          "oneOf": [
            { "$ref": "#/$defs/playerId" },
            { "type": "null" }
          ]
        },
        "decks": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/deck" }
        },
        "moduleState": { "$ref": "#/$defs/moduleState" },
        "pendingDecision": {
          "oneOf": [
            { "$ref": "#/$defs/pendingDecision" },
            { "type": "null" }
          ]
        },
        "continuation": {
          "oneOf": [
            { "$ref": "#/$defs/continuation" },
            { "type": "null" }
          ]
        },
        "consumedDecisionIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/guid" }
        },
        "lastConsumedDecisionId": {
          "oneOf": [
            { "$ref": "#/$defs/guid" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
